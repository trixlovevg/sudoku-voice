# Скопируйте этот файл в .env и заполните.
# После изменения .env перезапустите npm start (Ctrl+C, затем снова npm start).

# Ключ эмулятора: SmartApp Studio -> Профиль -> Настройки профиля -> Настройки сервисов
#   -> SmartApp -> вкладка «Эмулятор» -> «Обновить ключ» -> «Скопировать ключ»
REACT_APP_TOKEN=""

# Точное название CanvasApp в SmartApp Studio. Отправляется фразой «Запусти <название>»
# и должно совпасть с паттерном состояния Start в scenario/src/entryPoint.sc
REACT_APP_SMARTAPP="Судоку голосом"

# Адрес backend. Пусто = тот же сайт (в dev запросы проксируются на localhost:3001).
# Если фронтенд на GitHub Pages, а backend на другом хостинге — укажите его адрес:
# REACT_APP_API_URL="https://sudoku-voice.onrender.com"
REACT_APP_API_URL=""

#BROWSER=none
GENERATE_SOURCEMAP=false
