theme: /

    state: Ход
        # «поставь 5 в строку 3 столбец 4», «впиши девятку в 1 7», «цифра 7» (в выбранную клетку)
        q!: (~поставить | ставь | впиши | запиши | напиши | вставь | вбей | введи | ~цифра | ~число) [$AnyText::anyText]
        # «строка 3 столбец 4 цифра 5», «третья строка четвёртый столбец пятёрка»
        q!: [в] (~строка | ряд | ряду) $AnyText::anyText
        q!: $AnyText (~строка | ряд | ряду) [$AnyText]
        # «3 4 5», «345», «пять» — только цифры
        q!: $regex<^\s*[1-9](\s*[,.]?\s*[1-9]){0,2}\s*$>
        q!: (один | одна | два | две | три | четыре | пять | шесть | семь | восемь | девять | единица | двойка | тройка | четвёрка | четверка | пятёрка | пятерка | шестёрка | шестерка | семёрка | семерка | восьмёрка | восьмерка | девятка)
        script:
            log("Ход: " + $request.query);
            $reactions.answer(handleMove($context));

    state: ВыборКлетки
        q!: (выбери | выбрать | перейди | иди | покажи | открой | отметь) [на | в] [клетку | ячейку | клетка] $AnyText
        script:
            $reactions.answer(handleSelect($context));

    state: Стереть
        q!: (сотри | стереть | стёрла | очисти | очистить | удали | удалить | убери цифру) [$AnyText]
        script:
            $reactions.answer(handleErase($context));

    state: Навигация
        q!: [иди | шаг | сдвинь | клетка | на клетку] (вверх | выше | наверх | вниз | ниже | влево | левее | налево | вправо | правее | направо)
        script:
            var text = handleMoveSelection($context);
            if (text) $reactions.answer(text);
