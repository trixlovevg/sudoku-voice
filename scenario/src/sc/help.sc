theme: /

    state: Правила
        q!: (правила | помощь | справка | что ты умеешь | как играть | какие команды | что говорить)
        script:
            simpleAction("show_help", $context);
            $reactions.answer("Нужно заполнить поле так, чтобы в каждой строке, столбце и квадрате три на три цифры от 1 до 9 не повторялись. Говори: «строка 3 столбец 4 цифра 5», «сотри», «подсказка», «проверь», «отмени», «новая сложная игра».");
            addSuggestions(["Новая игра", "Подсказка", "Закрой"], $context);
